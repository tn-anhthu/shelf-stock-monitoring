# Copy this file to `.env` and fill in your real key — never commit `.env` itself
# (it's already in .gitignore). Used for the Task I LLM-escalation experiment
# (classify_crop tie-breaker via Claude vision API) discussed in this session.

# === Google Gemini (pilot, tuỳ chọn) ===
GEMINI_API_KEY=your-gemini-api-key
# gemini-2.5-flash and gemini-2.5-flash-lite (the 2.5 generation) are both
# retired -- "no longer available to new users" even with billing enabled --
# verified live against this project's own key. gemini-3.5-flash-lite (a
# different, newer generation's lite tier) confirmed working, at $0.30/$2.50
# per M input/output tokens -- the cheapest confirmed-working option
# (https://ai.google.dev/gemini-api/docs/pricing, checked 2026-07-27).
# gemini-3.6-flash (a full, non-lite tier) also confirmed working if quality
# matters more than cost: $1.50/$7.50 per M tokens.
GEMINI_ESCALATION_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini

# === OpenRouter (gap_verify) ===
OPENROUTER_API_KEY=sk-or-v1-...
GAP_VERIFY_MODEL=google/gemma-4-26b-a4b-it:free
GAP_VERIFY_FALLBACK_MODEL=openai/gpt-5.6-luna
