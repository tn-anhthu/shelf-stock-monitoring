# Copy this file to `.env` and fill in your real key — never commit `.env` itself
# (it's already in .gitignore). Used for the Task I LLM-escalation experiment
# (classify_crop tie-breaker via Claude vision API) discussed in this session.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model to use for the escalation experiment — Haiku is cheapest and has vision,
# no need for Sonnet/Opus for a simple "pick 1 of 2-3 SKUs" classification prompt.
CLAUDE_ESCALATION_MODEL=claude-haiku-4-5-20251001
